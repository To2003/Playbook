# Copiá este archivo a .env.local y completalo para activar la cuenta (login con Google,
# sincronización y "Compartir link"). Sin estas dos variables la app anda 100 % local.
# Las dos son públicas (van al navegador): NUNCA pongas acá la service_role / secret key.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# La "publishable key" (sb_publishable_…) o, en proyectos viejos, la "anon key".
NEXT_PUBLIC_SUPABASE_ANON_KEY=

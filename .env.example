# Copiá este archivo a .env.local y completalo para activar la cuenta (login con Google,
# sincronización y "Compartir link"). Sin estas dos variables la app anda 100 % local.
# Las dos son públicas (van al navegador): NUNCA pongas acá la service_role / secret key.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# La "publishable key" (sb_publishable_…) o, en proyectos viejos, la "anon key".
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Feedback de la beta (ver README, sección "Feedback"). Sin estas, "Mandar" abre WhatsApp
# o copia las respuestas.
NEXT_PUBLIC_FEEDBACK_FORM_URL=https://docs.google.com/forms/d/e/TU-FORM/formResponse
# JSON con el entry.XXXX de cada campo (los que no estén, no se mandan).
NEXT_PUBLIC_FEEDBACK_ENTRIES={"categorias":"entry.0000000001","usos":"entry.0000000002"}
# Número para el fallback de WhatsApp, con código de país y sin "+" (ej.: 5491155550000).
NEXT_PUBLIC_FEEDBACK_WHATSAPP=
